{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@domain": ["src/domain"],
      "@domain/*": ["src/domain/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@styles": ["src/styles"],
      "@styles/*": ["src/styles/*"],
      "@theme": ["src/theme"],
      "@theme/*": ["src/theme/*"],
      "@validations": ["src/validations"],
      "@validations/*": ["src/validations/*"]
    }
  } 
}
