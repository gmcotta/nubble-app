{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@api": ["src/api"],
      "@branding": ["src/branding"],
      "@components": ["src/components"],
      "@domain": ["src/domain"],
      "@hooks": ["src/hooks"],
      "@infra": ["src/infra"],
      "@routes": ["src/routes"],
      "@screens": ["src/screens"],
      "@services": ["src/services"],
      "@styles": ["src/styles"],
      "@test": ["src/test"],
      "test-utils": ["src/test/test-utils.tsx"],
      "@theme": ["src/theme"],
      "@types": ["src/types"],
      "@utils": ["src/utils"],
      "@validations": ["src/validations"]
    },
    "types": ["node", "jest"]
  }
}
